{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZaarvySkillsRegistry",
  "description": "Schema for the Zaarvy Skills Registry",
  "type": "object",
  "required": ["version", "updated_at", "skills"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry schema version"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last registry synchronization"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "category", "path"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Unique identifier matching the directory name"
          },
          "description": {
            "type": "string",
            "description": "Concise summary of skill purpose and activation criteria"
          },
          "category": {
            "type": "string",
            "enum": ["optimization", "code-analysis", "mocking", "testing", "security", "scaffolding"]
          },
          "path": {
            "type": "string",
            "description": "Relative path to skill directory"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Searchable classification tags"
          }
        }
      }
    }
  }
}
